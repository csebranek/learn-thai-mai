# Firebase configuration for Learn Thai Mai
# Copy this file to .env and fill in your values.
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
# See: https://firebase.google.com/docs/web/setup#config-object
#
# IMPORTANT: After rotating a key in Google Cloud Console > APIs & Services > Credentials,
# update the REACT_APP_FIREBASE_API_KEY value here and in your deployment environment.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
